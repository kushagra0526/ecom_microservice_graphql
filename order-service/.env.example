MONGO_URI=mongodb://mongodb:27017/order-service
PORT=3003
JWT_SECRET=your_jwt_secret_key_here
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002

# Kafka Configuration
# For local Docker Kafka (no authentication):
KAFKA_BROKER=kafka:29092

# For Upstash Kafka (with SASL authentication):
# KAFKA_BROKER=your-upstash-endpoint.upstash.io:9092
# KAFKA_USERNAME=your-upstash-username
# KAFKA_PASSWORD=your-upstash-password
# KAFKA_SASL_MECHANISM=scram-sha-256
